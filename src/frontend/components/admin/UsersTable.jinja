{#def users #}
<common.Table headers={{ ["Name", "Email", "Role", "Status"] }}>
  {% for user in users %}
  <tr>
    <td>{{ user.name }}</td>
    <td>{{ user.email }}</td>
    <td>
      {% if user.role == 'admin' %}
      <common.Pill variant="accent">Admin</common.Pill>
      {% else %}
      <common.Pill variant="neutral">Member</common.Pill>
      {% endif %}
    </td>
    <td>
      {% if user.is_active %}
      <common.Pill variant="good">Active</common.Pill>
      {% else %}
      <common.Pill variant="bad">Inactive</common.Pill>
      {% endif %}
    </td>
  </tr>
  {% endfor %}
</common.Table>
