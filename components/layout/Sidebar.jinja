{#def current_user=None, active=None #}
<aside class="sidebar">
  <div class="sidebar-brand">
    <span class="sidebar-brand-name">Circeus</span>
  </div>
  <nav class="sidebar-nav">
    <a href="/" class="sidebar-link {{ 'sidebar-link-active' if active == 'home' else '' }}">
      Home
    </a>
    {% if current_user and current_user.role == 'admin' %}
    <a href="/admin" class="sidebar-link {{ 'sidebar-link-active' if active == 'admin' else '' }}">
      Admin
    </a>
    {% endif %}
  </nav>
  <div class="sidebar-footer">
    {% if current_user %}
    <div class="sidebar-user">
      <span class="sidebar-user-name">{{ current_user.name }}</span>
      <span class="sidebar-user-email">{{ current_user.email }}</span>
    </div>
    {% endif %}
  </div>
</aside>
